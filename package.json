{
  "name": "fantasy-football-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run test/eval.test.ts",
    "lint": "prettier --check src test eval vitest.config.ts",
    "format": "prettier --write src test eval vitest.config.ts",
    "migrate:local": "wrangler d1 migrations apply fantasy --local",
    "migrate:remote": "wrangler d1 migrations apply fantasy --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^26.4.1",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.129.0"
  }
}
