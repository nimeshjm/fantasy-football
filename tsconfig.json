{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "vitest/globals", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // vitest.config.ts is included deliberately: the workers project's deploy
  // gate is wired up there, and an unchecked config is the one place a
  // mistake could quietly leave that guard checking nothing.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
